    "next": "^16.4.5",
    "next-sanity": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "react-masonry-css": "^1.0.16",
